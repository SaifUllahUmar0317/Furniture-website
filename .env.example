# ========================================================
# Tehkal Hafsa Furniture — Environment Configuration
# ========================================================

# Formspree Form ID or Endpoint for Contact & Custom Order forms
# You can use the Form ID (e.g. xzeebqnz) or the full endpoint URL
# Create a free form at https://formspree.io to receive inquiries directly in your inbox
VITE_FORMSPREE_FORM_ID=xzeebqnz

# Base path for deployment (default is /)
# If deploying to a subdirectory like https://example.com/subfolder/ set it to /subfolder/
BASE_PATH=/

# Local development port (default: 3000)
PORT=3000
